rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function verified() { return signedIn() && request.auth.token.email_verified == true; }
    function owner(uid) { return signedIn() && request.auth.uid == uid; }
    function ownedPostAsset(id, url, kind, folder) {
      let asset = get(/databases/$(database)/documents/cloudinaryAssets/$(id)).data;
      return asset.uid == request.auth.uid && asset.resourceType == kind
        && asset.publicId.matches('^pawly/' + folder + '/' + request.auth.uid + '/.+$')
        && asset.secureUrl == url;
    }
    function blockedEitherWay(uid) {
      return signedIn() && (
        exists(/databases/$(database)/documents/users/$(uid)/blocked/$(request.auth.uid)) ||
        exists(/databases/$(database)/documents/users/$(request.auth.uid)/blocked/$(uid))
      );
    }
    function getFollowersCount(data) {
      return ('followersCount' in data && data.followersCount is number) ? data.followersCount : 0;
    }
    function getFollowingCount(data) {
      return ('followingCount' in data && data.followingCount is number) ? data.followingCount : 0;
    }
    function admin() { return signedIn() && request.auth.token.admin == true; }

    match /usernames/{username} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid
        && existsAfter(/databases/$(database)/documents/usernameReservations/$(request.auth.uid))
        && getAfter(/databases/$(database)/documents/usernameReservations/$(request.auth.uid)).data.username == username;
      allow update: if false;
      allow delete: if signedIn()
        && resource.data.uid == request.auth.uid
        && !existsAfter(/databases/$(database)/documents/usernameReservations/$(request.auth.uid));
    }

    match /usernameReservations/{uid} {
      allow get: if owner(uid);
      allow list: if false;
      // The reservation is created in the same atomic batch as the username
      // and profile. The username rule validates this reservation with existsAfter.
      // Avoid a circular cross-document rule dependency which can reject the batch.
      allow create: if owner(uid)
        && request.resource.data.keys().hasOnly(['username'])
        && request.resource.data.username is string
        && request.resource.data.username.size() >= 3
        && request.resource.data.username.size() <= 24
        && !request.resource.data.username.matches('.*[^a-z0-9_.].*')
        && !exists(/databases/$(database)/documents/usernames/$(request.resource.data.username));
      allow update: if false;
      allow delete: if owner(uid)
        && !existsAfter(/databases/$(database)/documents/usernames/$(resource.data.username))
        && !existsAfter(/databases/$(database)/documents/users/$(uid));
    }

    match /users/{uid} {
      allow get: if owner(uid) || (signedIn() && resource.data.isPublic == true && !blockedEitherWay(uid));
      allow list: if signedIn() && resource.data.isPublic == true;
      allow create: if owner(uid)
        && request.resource.data.uid == uid
        && request.resource.data.username is string
        && request.resource.data.usernameLower is string
        && request.resource.data.isPublic == false
        && (!('isVerified' in request.resource.data) || request.resource.data.isVerified == false)
        && getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.usernameLower)).data.uid == uid
        && existsAfter(/databases/$(database)/documents/usernameReservations/$(uid))
        && getAfter(/databases/$(database)/documents/usernameReservations/$(uid)).data.username == request.resource.data.usernameLower;
      allow update: if (owner(uid)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.username == resource.data.username
        && request.resource.data.usernameLower == resource.data.usernameLower
        && (!('moderationStatus' in resource.data) || resource.data.moderationStatus != 'restricted' || request.resource.data.isPublic == false)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName', 'bio', 'photoUrl', 'isPublic', 'dogProfiles',
          'accountType', 'professionalCategory', 'professionalLocation',
          'professionalDescription', 'professionalContactPublic', 'professionalContact', 'professionalPublicContact'
        ])
        && !('professionalContact' in request.resource.data)
        && (!('accountType' in request.resource.data)
          || request.resource.data.accountType in ['personal', 'professional'])
        && (!('professionalCategory' in request.resource.data)
          || (request.resource.data.professionalCategory is string
            && request.resource.data.professionalCategory.size() <= 60))
        && (!('professionalLocation' in request.resource.data)
          || (request.resource.data.professionalLocation is string
            && request.resource.data.professionalLocation.size() <= 100))
        && (!('professionalDescription' in request.resource.data)
          || (request.resource.data.professionalDescription is string
            && request.resource.data.professionalDescription.size() <= 500))
        && (!('professionalContactPublic' in request.resource.data)
          || request.resource.data.professionalContactPublic is bool)
        && (!('professionalPublicContact' in request.resource.data)
          || (request.resource.data.professionalPublicContact is string
            && request.resource.data.professionalPublicContact.size() <= 120))
        && (!('accountType' in request.resource.data)
          || request.resource.data.accountType != 'professional'
          || ('professionalCategory' in request.resource.data
            && request.resource.data.professionalCategory is string
            && request.resource.data.professionalCategory.size() > 0)))
        || admin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isPublic', 'moderationStatus', 'isVerified'])
        && (!('isVerified' in request.resource.data) || request.resource.data.isVerified is bool)
        || verified()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['followersCount'])
        && (
          (request.resource.data.followersCount == getFollowersCount(resource.data) + 1
            && !exists(/databases/$(database)/documents/users/$(uid)/followers/$(request.auth.uid))
            && existsAfter(/databases/$(database)/documents/users/$(uid)/followers/$(request.auth.uid)))
          ||
          (request.resource.data.followersCount == getFollowersCount(resource.data) - 1
            && exists(/databases/$(database)/documents/users/$(uid)/followers/$(request.auth.uid))
            && !existsAfter(/databases/$(database)/documents/users/$(uid)/followers/$(request.auth.uid)))
        )
        || verified()
        && owner(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['followingCount', 'lastFollowingChangeUid'])
        && request.resource.data.lastFollowingChangeUid is string
        && request.resource.data.lastFollowingChangeUid.size() > 0
        && request.resource.data.lastFollowingChangeUid.size() <= 128
        && (
          (request.resource.data.followingCount == getFollowingCount(resource.data) + 1
            && !exists(/databases/$(database)/documents/users/$(uid)/following/$(request.resource.data.lastFollowingChangeUid))
            && existsAfter(/databases/$(database)/documents/users/$(uid)/following/$(request.resource.data.lastFollowingChangeUid)))
          ||
          (request.resource.data.followingCount == getFollowingCount(resource.data) - 1
            && exists(/databases/$(database)/documents/users/$(uid)/following/$(request.resource.data.lastFollowingChangeUid))
            && !existsAfter(/databases/$(database)/documents/users/$(uid)/following/$(request.resource.data.lastFollowingChangeUid)))
        )
        || owner(uid) && verified()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['followersCount','followingCount','lastFollowingChangeUid','lastBlockedUid'])
        && request.resource.data.lastBlockedUid is string
        && existsAfter(/databases/$(database)/documents/users/$(uid)/blocked/$(request.resource.data.lastBlockedUid))
        && exists(/databases/$(database)/documents/users/$(uid)/followers/$(request.resource.data.lastBlockedUid))
        && !existsAfter(/databases/$(database)/documents/users/$(uid)/followers/$(request.resource.data.lastBlockedUid))
        && request.resource.data.followersCount == getFollowersCount(resource.data) - 1
        && (getFollowingCount(request.resource.data) == getFollowingCount(resource.data)
          || (getFollowingCount(request.resource.data) == getFollowingCount(resource.data) - 1
            && exists(/databases/$(database)/documents/users/$(uid)/following/$(request.resource.data.lastBlockedUid))
            && !existsAfter(/databases/$(database)/documents/users/$(uid)/following/$(request.resource.data.lastBlockedUid))))
        || verified()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['followersCount', 'followingCount'])
        && (request.resource.data.followersCount == getFollowersCount(resource.data)
          || (request.resource.data.followersCount == getFollowersCount(resource.data) - 1
            && exists(/databases/$(database)/documents/users/$(uid)/followers/$(request.auth.uid))
            && !existsAfter(/databases/$(database)/documents/users/$(uid)/followers/$(request.auth.uid))))
        && (request.resource.data.followingCount == getFollowingCount(resource.data)
          || (request.resource.data.followingCount == getFollowingCount(resource.data) - 1
            && exists(/databases/$(database)/documents/users/$(uid)/following/$(request.auth.uid))
            && !existsAfter(/databases/$(database)/documents/users/$(uid)/following/$(request.auth.uid))));
      allow delete: if owner(uid);

      match /privateData/{privateDocumentId} {
        allow get: if owner(uid) || (signedIn()
          && privateDocumentId == 'professionalContact'
          && get(/databases/$(database)/documents/users/$(uid)).data.isPublic == true
          && get(/databases/$(database)/documents/users/$(uid)).data.professionalContactPublic == true
          && !blockedEitherWay(uid));
        allow list: if false;
        allow create, update: if owner(uid) && (
          (privateDocumentId == 'mapFavourites'
            && request.resource.data.keys().hasOnly(['entries', 'updatedAt'])
            && request.resource.data.entries is list && request.resource.data.entries.size() <= 100
            && request.resource.data.updatedAt == request.time)
          || (privateDocumentId == 'professionalContact'
            && request.resource.data.keys().hasOnly(['value'])
            && request.resource.data.value is string
            && request.resource.data.value.size() <= 120)
          || (privateDocumentId == 'home'
            && request.resource.data.keys().hasOnly(['dogName', 'dogProfiles', 'selectedPetId', 'updatedAt'])
            && request.resource.data.keys().hasAll(['dogName', 'dogProfiles', 'updatedAt'])
            && request.resource.data.dogName is string
            && request.resource.data.dogName.size() > 0
            && request.resource.data.dogName.size() <= 40
            && request.resource.data.dogProfiles is list
            && request.resource.data.dogProfiles.size() <= 100
            && (!('selectedPetId' in request.resource.data)
              || (request.resource.data.selectedPetId is string
                && request.resource.data.selectedPetId.size() <= 128))
            && request.resource.data.updatedAt == request.time)
        );
        allow delete: if owner(uid) && privateDocumentId == 'professionalContact';
      }

      // Private Explore collections sync across the owner's devices.
      match /exploreCollections/{collectionId} {
        allow get, list: if owner(uid);
        allow create, update: if owner(uid)
          && request.resource.data.keys().hasOnly(['name', 'description', 'entries', 'updatedAt'])
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 32
          && request.resource.data.description is string
          && request.resource.data.description.size() <= 120
          && request.resource.data.entries is list
          && request.resource.data.entries.size() <= 100
          && request.resource.data.updatedAt == request.time;
        allow delete: if owner(uid);
      }

      match /notifications/{notificationId} {
        function actorProfile() {
          return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
        }
        function sourcePost() {
          return get(/databases/$(database)/documents/posts/$(request.resource.data.relatedId)).data;
        }
        function sourceComment() {
          return getAfter(/databases/$(database)/documents/posts/$(request.resource.data.relatedId)/comments/$(request.resource.data.sourceEventId)).data;
        }
        function validActorName() {
          return request.resource.data.actorName == actorProfile().get('displayName','')
            || request.resource.data.actorName == actorProfile().get('username','');
        }
        function validActivitySource() {
          return request.resource.data.type == 'LIKE'
            && request.resource.data.relatedId is string
            && request.resource.data.sourceEventId == request.resource.data.relatedId
            && sourcePost().authorId == uid
            && request.auth.uid in sourcePost().likedBy
            && notificationId == 'LIKE-' + request.auth.uid + '-' + request.resource.data.relatedId
          || request.resource.data.type == 'COMMENT'
            && request.resource.data.relatedId is string
            && request.resource.data.sourceEventId is string
            && request.resource.data.sourceEventId.size() > 0
            && sourceComment().get('replyToAuthorId', sourcePost().authorId) == uid
            && getAfter(/databases/$(database)/documents/posts/$(request.resource.data.relatedId)).data.lastCommentId == request.resource.data.sourceEventId
            && sourceComment().authorId == request.auth.uid
            && notificationId == 'COMMENT-' + request.auth.uid + '-' + request.resource.data.sourceEventId
          || request.resource.data.type == 'FOLLOW'
            && request.resource.data.relatedId == ''
            && request.resource.data.sourceEventId == ''
            && exists(/databases/$(database)/documents/users/$(uid)/followers/$(request.auth.uid))
            && notificationId == 'FOLLOW-' + request.auth.uid + '-' + uid;
        }
        allow get, list: if owner(uid);
        // The client may only report a real, verifiable interaction. Arbitrary
        // notification text, actor spoofing, blocked interactions and replayed
        // IDs are rejected by the rules.
        allow create: if verified()
          && request.auth.uid != uid
          && !blockedEitherWay(uid)
          && request.resource.data.keys().hasOnly([
            'actorId', 'actorName', 'type', 'message', 'relatedId',
            'sourceEventId', 'createdAt', 'read'
          ])
          && request.resource.data.actorId == request.auth.uid
          && request.resource.data.actorName is string
          && request.resource.data.actorName.size() <= 80
          && validActorName()
          && request.resource.data.type in ['LIKE', 'COMMENT', 'FOLLOW']
          && request.resource.data.message == (
            request.resource.data.type == 'LIKE' ? 'Le ha gustado tu publicación.'
              : request.resource.data.type == 'COMMENT' ? ('replyToId' in sourceComment() ? 'Ha respondido a tu comentario.' : 'Ha comentado tu publicación.')
              : 'Ha empezado a seguirte.'
          )
          && request.resource.data.relatedId is string
          && request.resource.data.relatedId.size() <= 128
          && request.resource.data.sourceEventId is string
          && request.resource.data.sourceEventId.size() <= 128
          && request.resource.data.createdAt == request.time
          && request.resource.data.read == false
          && validActivitySource();
        allow update: if owner(uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
          && request.resource.data.read == true;
        allow delete: if owner(uid);
      }

      match /following/{otherUid} {
        allow read: if owner(uid) || (signedIn() && request.auth.uid == otherUid);
        allow create: if owner(uid) && verified() && request.resource.data.uid == otherUid && !blockedEitherWay(otherUid);
        allow delete: if owner(uid) || (signedIn() && request.auth.uid == otherUid);
        allow update: if false;
      }
      match /followers/{followerUid} {
        allow read: if owner(uid) || (signedIn() && request.auth.uid == followerUid);
        allow create: if verified() && request.auth.uid == followerUid && request.resource.data.uid == followerUid && !blockedEitherWay(uid);
        allow delete: if owner(uid) || (signedIn() && request.auth.uid == followerUid);
        allow update: if false;
      }
      match /blocked/{otherUid} {
        allow read: if owner(uid) || (signedIn() && request.auth.uid == otherUid);
        allow create: if owner(uid) && request.resource.data.uid == otherUid;
        allow delete: if owner(uid);
        allow update: if false;
      }

      // Reverse index: lets the blocked account hide the blocker from its
      // community surfaces without exposing the blocker's other relationships.
      match /blockedBy/{blockerUid} {
        allow read: if owner(uid);
        allow create: if signedIn()
          && request.auth.uid == blockerUid
          && request.resource.data.keys().hasOnly(['uid', 'createdAt'])
          && request.resource.data.uid == blockerUid
          && request.resource.data.createdAt == request.time;
        allow delete: if signedIn() && request.auth.uid == blockerUid;
        allow update: if false;
      }

      match /fcmTokens/{tokenId} {
        allow read: if owner(uid);
        allow create, update: if owner(uid)
          && request.resource.data.keys().hasOnly(['token', 'platform', 'updatedAt'])
          && request.resource.data.token is string
          && request.resource.data.token.size() <= 4096
          && request.resource.data.platform in ['android', 'ios'];
        allow delete: if owner(uid);
      }

      // Private Home pet profile used to restore the selected name on another device.
      match /privateData/{documentId} {
        allow get: if owner(uid) && documentId == 'home';
        allow list: if false;
        allow create, update: if owner(uid)
          && documentId == 'home'
          && request.resource.data.keys().hasOnly(['dogName', 'dogProfiles', 'selectedPetId', 'updatedAt'])
          && request.resource.data.keys().hasAll(['dogName', 'dogProfiles', 'updatedAt'])
          && (!('selectedPetId' in request.resource.data)
            || (request.resource.data.selectedPetId is string && request.resource.data.selectedPetId.size() <= 128))
          && request.resource.data.dogName is string
          && request.resource.data.dogName.size() > 0
          && request.resource.data.dogName.size() <= 40
          && request.resource.data.dogProfiles is list
          && request.resource.data.dogProfiles.size() > 0
          && request.resource.data.dogProfiles.size() <= 100
          && request.resource.data.dogProfiles.hasAll([request.resource.data.dogName])
          && request.resource.data.updatedAt is timestamp;
        allow delete: if false;
      }

      // Private health passport and care routines. These records are never public.
      match /petCare/{petId} {
        allow read, write: if owner(uid);

        match /passport/{entryId} {
          allow read, delete: if owner(uid);
          allow create, update: if owner(uid)
            && request.resource.data.keys().hasOnly([
              'id', 'type', 'title', 'detail', 'date', 'product', 'dose',
              'frequency', 'clinic', 'nextDoseDate', 'status',
              'reminderEnabled', 'reminderTime', 'createdAtOrder'
            ])
            && request.resource.data.id == entryId
            && request.resource.data.type is string && request.resource.data.type.size() <= 40
            && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 120
            && request.resource.data.detail is string && request.resource.data.detail.size() <= 1200
            && request.resource.data.date is string && request.resource.data.date.size() <= 40
            && (!('product' in request.resource.data) || (request.resource.data.product is string && request.resource.data.product.size() <= 120))
            && (!('dose' in request.resource.data) || (request.resource.data.dose is string && request.resource.data.dose.size() <= 120))
            && (!('frequency' in request.resource.data) || (request.resource.data.frequency is string && request.resource.data.frequency.size() <= 120))
            && (!('clinic' in request.resource.data) || (request.resource.data.clinic is string && request.resource.data.clinic.size() <= 120))
            && (!('nextDoseDate' in request.resource.data) || (request.resource.data.nextDoseDate is string && request.resource.data.nextDoseDate.size() <= 10))
            && (!('status' in request.resource.data) || request.resource.data.status in ['PENDIENTE', 'REALIZADO', 'VENCIDO'])
            && (!('reminderEnabled' in request.resource.data) || request.resource.data.reminderEnabled is bool)
            && (!('reminderTime' in request.resource.data) || (request.resource.data.reminderTime is string && request.resource.data.reminderTime.matches('^(?:[01][0-9]|2[0-3]):[0-5][0-9]$')))
            && (!('createdAtOrder' in request.resource.data) || request.resource.data.createdAtOrder is int);
        }

        match /tasks/{taskId} {
          allow read, delete: if owner(uid);
          allow create, update: if owner(uid)
            && request.resource.data.keys().hasOnly(['id', 'title', 'responsible', 'frequency', 'completed', 'dose', 'time', 'completedOn', 'action', 'daysOfWeek'])
            && request.resource.data.id == taskId
            && request.resource.data.title is string
            && request.resource.data.title.size() > 0
            && request.resource.data.title.size() <= 120
            && request.resource.data.responsible is string
            && request.resource.data.responsible.size() <= 80
            && request.resource.data.frequency is string
            && request.resource.data.frequency.size() <= 80
            && request.resource.data.completed is bool
            && request.resource.data.dose is string && request.resource.data.dose.size() <= 80
            && request.resource.data.time is string && request.resource.data.time.size() <= 5
            && request.resource.data.completedOn is string && request.resource.data.completedOn.size() <= 10
            && request.resource.data.action in ['Paseo', 'Comida', 'Medicación', 'Higiene', 'Otro']
          && (!('daysOfWeek' in request.resource.data) || (
            request.resource.data.frequency == 'Semanal'
            && request.resource.data.daysOfWeek is list
            && request.resource.data.daysOfWeek.size() <= 7
            && request.resource.data.daysOfWeek.hasOnly([1, 2, 3, 4, 5, 6, 7])
          ));
        }
        match /careLogs/{logId} {
          allow read, delete: if owner(uid);
          allow create: if owner(uid)
            && request.resource.data.keys().hasOnly([
              'id', 'taskTitle', 'action', 'actorUid', 'actorName', 'occurredAt', 'note',
              'distanceKm', 'mapUrl', 'description', 'walker', 'photoUrls','videoUrl','videoAssetId'
            ])
            && request.resource.data.id == logId
            && request.resource.data.actorUid == request.auth.uid
            && request.resource.data.taskTitle is string && request.resource.data.taskTitle.size() > 0 && request.resource.data.taskTitle.size() <= 120
            && request.resource.data.action in ['Paseo', 'Comida', 'Medicación', 'Higiene', 'Otro']
            && request.resource.data.actorName is string && request.resource.data.actorName.size() <= 80
            && request.resource.data.occurredAt == request.time
            && request.resource.data.note is string && request.resource.data.note.size() <= 500
            && (!('distanceKm' in request.resource.data) || (request.resource.data.distanceKm is number && request.resource.data.distanceKm >= 0.01 && request.resource.data.distanceKm <= 1000))
            && (!('mapUrl' in request.resource.data) || (request.resource.data.mapUrl is string && request.resource.data.mapUrl.size() <= 2048 && (request.resource.data.mapUrl == '' || request.resource.data.mapUrl.matches('^https?://.+$'))))
            && (!('description' in request.resource.data) || (request.resource.data.description is string && request.resource.data.description.size() <= 600))
            && (!('walker' in request.resource.data) || (request.resource.data.walker is string && request.resource.data.walker.size() <= 80))
            && (!request.resource.data.keys().hasAny(['videoUrl','videoAssetId']) || (request.resource.data.videoAssetId.matches('^[a-f0-9]{64}$') && ownedPostAsset(request.resource.data.videoAssetId,request.resource.data.videoUrl,'video','pet-videos')))
          && (!('photoUrls' in request.resource.data) || (request.resource.data.photoUrls is list && request.resource.data.photoUrls.size() <= 4));
        }
      }
    }


    // Shared pet profile invitations and role-protected health records.
    match /sharedPets/{sharedPetId} {
      function isMember() {
        return signedIn() && exists(/databases/$(database)/documents/sharedPets/$(sharedPetId)/members/$(request.auth.uid));
      }
      function isMemberAfter() {
        return signedIn() && existsAfter(/databases/$(database)/documents/sharedPets/$(sharedPetId)/members/$(request.auth.uid));
      }
      allow get: if signedIn() && (isMember() || sharedPetId.matches('^' + request.auth.uid + '_.*'));
      allow list: if false;
      allow create: if verified()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.id == sharedPetId
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 40;
      allow update: if verified() && resource.data.ownerUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'updatedAt'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 40;
      allow delete: if false;

      match /members/{memberUid} {
        allow read: if isMember();
        allow create: if verified() && (
          (getAfter(/databases/$(database)/documents/sharedPets/$(sharedPetId)).data.ownerUid == request.auth.uid
            && memberUid == request.auth.uid && request.resource.data.role == 'owner')
          ||
          (memberUid == request.auth.uid
            && existsAfter(/databases/$(database)/documents/petInvitations/$(request.resource.data.invitationId))
            && getAfter(/databases/$(database)/documents/petInvitations/$(request.resource.data.invitationId)).data.inviteeUid == request.auth.uid
            && getAfter(/databases/$(database)/documents/petInvitations/$(request.resource.data.invitationId)).data.sharedPetId == sharedPetId
            && getAfter(/databases/$(database)/documents/petInvitations/$(request.resource.data.invitationId)).data.status == 'accepted'
            && request.resource.data.role == getAfter(/databases/$(database)/documents/petInvitations/$(request.resource.data.invitationId)).data.role
            && request.resource.data.role in ['editor', 'reader'])
        );
        allow delete: if verified()
          && get(/databases/$(database)/documents/sharedPets/$(sharedPetId)).data.ownerUid == request.auth.uid
          && memberUid != request.auth.uid;
        allow update: if verified()
          && get(/databases/$(database)/documents/sharedPets/$(sharedPetId)).data.ownerUid == request.auth.uid
          && memberUid != request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role'])
          && request.resource.data.role in ['editor', 'reader'];
      }

      // Shared health data is visible only to accepted members of the pet profile.
      // Owners and editors can change records; readers have read-only access.
      match /passport/{entryId} {
        allow read: if isMember();
        allow create, update: if isMember()
          && get(/databases/$(database)/documents/sharedPets/$(sharedPetId)/members/$(request.auth.uid)).data.role in ['owner', 'editor']
          && request.resource.data.keys().hasOnly([
              'id', 'type', 'title', 'detail', 'date', 'product', 'dose',
              'frequency', 'clinic', 'nextDoseDate', 'status',
              'reminderEnabled', 'reminderTime', 'createdAtOrder'
            ])
          && request.resource.data.id == entryId
          && request.resource.data.type is string && request.resource.data.type.size() <= 40
          && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 120
          && request.resource.data.detail is string && request.resource.data.detail.size() <= 1200
          && request.resource.data.date is string && request.resource.data.date.size() <= 40
          && (!('product' in request.resource.data) || (request.resource.data.product is string && request.resource.data.product.size() <= 120))
          && (!('dose' in request.resource.data) || (request.resource.data.dose is string && request.resource.data.dose.size() <= 120))
          && (!('frequency' in request.resource.data) || (request.resource.data.frequency is string && request.resource.data.frequency.size() <= 120))
          && (!('clinic' in request.resource.data) || (request.resource.data.clinic is string && request.resource.data.clinic.size() <= 120))
          && (!('nextDoseDate' in request.resource.data) || (request.resource.data.nextDoseDate is string && request.resource.data.nextDoseDate.size() <= 10))
          && (!('status' in request.resource.data) || request.resource.data.status in ['PENDIENTE', 'REALIZADO', 'VENCIDO'])
          && (!('reminderEnabled' in request.resource.data) || request.resource.data.reminderEnabled is bool)
          && (!('reminderTime' in request.resource.data) || (request.resource.data.reminderTime is string && request.resource.data.reminderTime.matches('^(?:[01][0-9]|2[0-3]):[0-5][0-9]$')))
          && (!('createdAtOrder' in request.resource.data) || request.resource.data.createdAtOrder is int);
        allow delete: if isMember()
          && get(/databases/$(database)/documents/sharedPets/$(sharedPetId)/members/$(request.auth.uid)).data.role in ['owner', 'editor'];
      }
      match /tasks/{taskId} {
        allow read: if isMember();
        allow create, update: if isMember()
          && get(/databases/$(database)/documents/sharedPets/$(sharedPetId)/members/$(request.auth.uid)).data.role in ['owner', 'editor']
          && request.resource.data.keys().hasOnly(['id', 'title', 'responsible', 'frequency', 'completed', 'dose', 'time', 'completedOn', 'action', 'daysOfWeek'])
          && request.resource.data.id == taskId
          && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 120
          && request.resource.data.responsible is string && request.resource.data.responsible.size() <= 80
          && request.resource.data.frequency is string && request.resource.data.frequency.size() <= 80
          && request.resource.data.completed is bool
          && request.resource.data.dose is string && request.resource.data.dose.size() <= 80
          && request.resource.data.time is string && request.resource.data.time.size() <= 5
          && request.resource.data.completedOn is string && request.resource.data.completedOn.size() <= 10
          && request.resource.data.action in ['Paseo', 'Comida', 'Medicación', 'Higiene', 'Otro']
          && (!('daysOfWeek' in request.resource.data) || (
            request.resource.data.frequency == 'Semanal'
            && request.resource.data.daysOfWeek is list
            && request.resource.data.daysOfWeek.size() <= 7
            && request.resource.data.daysOfWeek.hasOnly([1, 2, 3, 4, 5, 6, 7])
          ));
        allow delete: if isMember()
          && get(/databases/$(database)/documents/sharedPets/$(sharedPetId)/members/$(request.auth.uid)).data.role in ['owner', 'editor'];
      }
      match /careLogs/{logId} {
        allow read: if isMember();
        allow create: if isMember()
          && get(/databases/$(database)/documents/sharedPets/$(sharedPetId)/members/$(request.auth.uid)).data.role in ['owner', 'editor']
          && request.resource.data.keys().hasOnly([
              'id', 'taskTitle', 'action', 'actorUid', 'actorName', 'occurredAt', 'note',
              'distanceKm', 'mapUrl', 'description', 'walker', 'photoUrls','videoUrl','videoAssetId'
            ])
          && request.resource.data.id == logId
          && request.resource.data.actorUid == request.auth.uid
          && request.resource.data.taskTitle is string && request.resource.data.taskTitle.size() > 0 && request.resource.data.taskTitle.size() <= 120
          && request.resource.data.action in ['Paseo', 'Comida', 'Medicación', 'Higiene', 'Otro']
          && request.resource.data.actorName is string && request.resource.data.actorName.size() <= 80
          && request.resource.data.occurredAt == request.time
          && request.resource.data.note is string && request.resource.data.note.size() <= 500
          && (!('distanceKm' in request.resource.data) || (request.resource.data.distanceKm is number && request.resource.data.distanceKm >= 0.01 && request.resource.data.distanceKm <= 1000))
          && (!('mapUrl' in request.resource.data) || (request.resource.data.mapUrl is string && request.resource.data.mapUrl.size() <= 2048 && (request.resource.data.mapUrl == '' || request.resource.data.mapUrl.matches('^https?://.+$'))))
          && (!('description' in request.resource.data) || (request.resource.data.description is string && request.resource.data.description.size() <= 600))
          && (!('walker' in request.resource.data) || (request.resource.data.walker is string && request.resource.data.walker.size() <= 80))
          && (!request.resource.data.keys().hasAny(['videoUrl','videoAssetId']) || (request.resource.data.videoAssetId.matches('^[a-f0-9]{64}$') && ownedPostAsset(request.resource.data.videoAssetId,request.resource.data.videoUrl,'video','pet-videos')))
          && (!('photoUrls' in request.resource.data) || (request.resource.data.photoUrls is list && request.resource.data.photoUrls.size() <= 4));
        allow delete: if isMember()
          && get(/databases/$(database)/documents/sharedPets/$(sharedPetId)/members/$(request.auth.uid)).data.role in ['owner', 'editor'];
      }
      match /profile/{profileId} {
        function validProfileData() {
          return request.resource.data.keys().hasOnly(['petId', 'name', 'photoUrl', 'updatedAt'])
            && request.resource.data.petId is string
            && request.resource.data.name is string
            && request.resource.data.name.size() > 0
            && request.resource.data.name.size() <= 40
            && (request.resource.data.photoUrl == null
              || (request.resource.data.photoUrl is string
                && request.resource.data.photoUrl.matches('^https://.+$')
                && request.resource.data.photoUrl.size() <= 2048));
        }
        function canCreateOrUpdateProfile() {
          return (isMember()
              && get(/databases/$(database)/documents/sharedPets/$(sharedPetId)/members/$(request.auth.uid)).data.role in ['owner', 'editor'])
            || (isMemberAfter()
              && getAfter(/databases/$(database)/documents/sharedPets/$(sharedPetId)/members/$(request.auth.uid)).data.role == 'owner');
        }
        allow read: if isMember() && profileId == 'current';
        // The first profile and owner membership are written in the same batch.
        // Existing owners/editors can also create the document if it was removed.
        allow create, update: if canCreateOrUpdateProfile()
          && profileId == 'current'
          && validProfileData();
        allow delete: if isMember() && profileId == 'current'
          && get(/databases/$(database)/documents/sharedPets/$(sharedPetId)/members/$(request.auth.uid)).data.role == 'owner';
      }
      // Shared agenda reminders are independent documents: edits on one device
      // cannot overwrite a complete local reminder list from another device.
      match /agenda/{reminderId} {
        allow read: if isMember();
        allow create: if isMember()
          && get(/databases/$(database)/documents/sharedPets/$(sharedPetId)/members/$(request.auth.uid)).data.role in ['owner', 'editor']
          && request.resource.data.keys().hasOnly(['id', 'title', 'date', 'category', 'createdBy', 'updatedAt'])
          && request.resource.data.id == reminderId
          && request.resource.data.title is string && request.resource.data.title.size() >= 2 && request.resource.data.title.size() <= 100
          && request.resource.data.date is int && request.resource.data.date >= 0 && request.resource.data.date <= 4102444800000
          && request.resource.data.category in ['Personal', 'Veterinario', 'Cuidado', 'Paseo', 'Viaje']
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.updatedAt == request.time;
        allow update: if isMember()
          && get(/databases/$(database)/documents/sharedPets/$(sharedPetId)/members/$(request.auth.uid)).data.role in ['owner', 'editor']
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'date', 'category', 'updatedAt'])
          && request.resource.data.id == resource.data.id
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.title is string && request.resource.data.title.size() >= 2 && request.resource.data.title.size() <= 100
          && request.resource.data.date is int && request.resource.data.date >= 0 && request.resource.data.date <= 4102444800000
          && request.resource.data.category in ['Personal', 'Veterinario', 'Cuidado', 'Paseo', 'Viaje']
          && request.resource.data.updatedAt == request.time;
        allow delete: if isMember()
          && get(/databases/$(database)/documents/sharedPets/$(sharedPetId)/members/$(request.auth.uid)).data.role in ['owner', 'editor'];
      }
      // Shared expense records are scoped to the pet and visible to accepted members.
      match /expenses/{expenseId} {
        function canEditExpense() {
          return isMember()
            && get(/databases/$(database)/documents/sharedPets/$(sharedPetId)/members/$(request.auth.uid)).data.role in ['owner', 'editor'];
        }
        function validExpense() {
          return request.resource.data.keys().hasOnly([
            'id', 'kind', 'title', 'detail', 'amount', 'date', 'createdBy', 'updatedAt'
          ])
          && request.resource.data.id == expenseId
          && request.resource.data.kind in ['Alimentación', 'Higiene', 'Gasto veterinario', 'Accesorios', 'Otros']
          && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 80
          && request.resource.data.detail is string && request.resource.data.detail.size() <= 500
          && request.resource.data.amount is number && request.resource.data.amount > 0 && request.resource.data.amount <= 100000
          && request.resource.data.date is int && request.resource.data.date >= 0 && request.resource.data.date <= 4102444800000
          && request.resource.data.updatedAt == request.time;
        }
        allow read: if isMember();
        allow create: if canEditExpense()
          && request.resource.data.createdBy == request.auth.uid
          && validExpense();
        allow update: if canEditExpense()
          && request.resource.data.createdBy == resource.data.createdBy
          && validExpense();
        allow delete: if canEditExpense();
      }
      match /diary/{entryId} {
        allow read: if isMember();
        allow create, update: if isMember()
          && get(/databases/$(database)/documents/sharedPets/$(sharedPetId)/members/$(request.auth.uid)).data.role in ['owner', 'editor']
          && request.resource.data.keys().hasOnly(['id', 'text', 'position', 'updatedAt'])
          && request.resource.data.id == entryId
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 12000
          && request.resource.data.position is int
          && request.resource.data.position >= 0
          && request.resource.data.position <= 499;
        allow delete: if isMember()
          && get(/databases/$(database)/documents/sharedPets/$(sharedPetId)/members/$(request.auth.uid)).data.role in ['owner', 'editor'];
      }
    }

    match /petInvitations/{invitationId} {
      allow create: if verified()
        && request.resource.data.keys().hasOnly(['sharedPetId', 'petName', 'ownerUid', 'ownerName', 'inviteeUid', 'inviteeUsername', 'role', 'status', 'createdAt'])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.inviteeUid is string
        && request.resource.data.inviteeUid != request.auth.uid
        && request.resource.data.inviteeUsername is string
        && request.resource.data.inviteeUsername.size() >= 3
        && request.resource.data.inviteeUsername.size() <= 24
        && request.resource.data.petName is string
        && request.resource.data.petName.size() <= 40
        && request.resource.data.ownerName is string
        && request.resource.data.ownerName.size() <= 50
        && request.resource.data.sharedPetId is string
        && exists(/databases/$(database)/documents/sharedPets/$(request.resource.data.sharedPetId))
        && get(/databases/$(database)/documents/sharedPets/$(request.resource.data.sharedPetId)).data.ownerUid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.role in ['editor', 'reader'];
      allow read: if verified() && (resource.data.ownerUid == request.auth.uid || resource.data.inviteeUid == request.auth.uid);
      allow update: if verified() && (
        (resource.data.inviteeUid == request.auth.uid
          && resource.data.status == 'pending'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'respondedAt'])
          && request.resource.data.status in ['accepted', 'declined'])
        ||
        (resource.data.ownerUid == request.auth.uid
          && resource.data.status == 'accepted'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'revokedAt'])
          && request.resource.data.status == 'revoked')
        ||
        (resource.data.ownerUid == request.auth.uid
          && resource.data.status == 'accepted'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role'])
          && request.resource.data.role in ['editor', 'reader'])
      );
      allow delete: if false;
    }

    function validLostCell(data, lat, lon) {
      return data.keys().hasAll([lat, lon]) && data[lat] is int && data[lon] is int
        && data[lat] >= -9000 && data[lat] <= 9000 && data[lon] >= -18000 && data[lon] <= 18000;
    }
    function alertMatchesPost(alert, post) {
      return !post.get('lostAreaEdited', false) && validLostCell(alert, 'latCell', 'lonCell')
        && alert.latCell == post.lostLatCell && alert.lonCell == post.lostLonCell;
    }

    match /postPublishLimits/{uid} {
      function newPost(id) { return /databases/$(database)/documents/posts/$(id); }
      allow create, update: if owner(uid) && request.resource.data.keys().hasOnly(['postId','at'])
        && request.resource.data.postId.matches('^[a-zA-Z0-9_-]{1,128}$') && request.resource.data.at == request.time
        && (resource == null || request.time >= resource.data.at + duration.value(60,'s'))
        && !exists(newPost(request.resource.data.postId)) && getAfter(newPost(request.resource.data.postId)).data.authorId == uid;
    }

    match /posts/{postId} {
      allow read: if signedIn();
      function limitedPublisher(d) {
        let profile = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
        let limit = getAfter(/databases/$(database)/documents/postPublishLimits/$(request.auth.uid)).data;
        return request.auth.token.get('email','') != '' && limit.at == request.time && limit.postId == postId
          && profile.uid == request.auth.uid && d.authorName in [profile.get('displayName',''),profile.get('username','')]
          && d.createdAt == request.time && d.likeCount == 0 && d.commentCount == 0 && d.likedBy == []
          && (d.imageUrl == '' || ownedPostAsset(d.imageAssetId,d.imageUrl,'image','post-photos'))
          && (d.get('videoUrl','') == '' || ownedPostAsset(d.videoAssetId,d.videoUrl,'video','post-videos'));
      }
      allow create: if signedIn() && (verified() || limitedPublisher(request.resource.data))
        && (!request.resource.data.keys().hasAny(['lostLatCell','lostLonCell']) ||
          (request.resource.data.category == 'LOST' && validLostCell(request.resource.data,'lostLatCell','lostLonCell')
           && !request.resource.data.get('lostAreaEdited',false)))
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 2000
        && request.resource.data.imageUrl is string
        && request.resource.data.imageUrl.size() <= 2048
          && (request.resource.data.imageUrl.size() == 0 || request.resource.data.imageUrl.matches('^https://.+$'))
        && (!('videoUrl' in request.resource.data)
          || (request.resource.data.videoUrl is string
            && (request.resource.data.videoUrl.size() == 0 || request.resource.data.videoUrl.matches('^https://.+$'))
            && request.resource.data.videoUrl.size() <= 2048))
        && (request.resource.data.text.size() > 0
          || request.resource.data.imageUrl.size() > 0
          || ('videoUrl' in request.resource.data && request.resource.data.videoUrl.size() > 0))
        && (!('category' in request.resource.data) || request.resource.data.category in ['STORY', 'ADOPTION', 'LOST', 'FOUND', 'FOSTER']);
      function validLostMedia(d) {
        return d.imageUrl is string && d.get('videoUrl','') is string
          && ((d.imageUrl == '' && d.get('videoUrl','') == '' && !('lostMediaAssetId' in d))
          || (d.lostMediaAssetId.matches('^[a-f0-9]{64}$')
          && ((d.imageUrl == '' && ownedPostAsset(d.lostMediaAssetId, d.videoUrl, 'video','post-videos'))
          || (d.get('videoUrl','') == '' && ownedPostAsset(d.lostMediaAssetId, d.imageUrl, 'image','post-photos')))));
      }
      function validAreaChange() {
        let post = request.resource.data;
        let alert = /databases/$(database)/documents/lostPetAlerts/$(postId);
        return ((!post.keys().hasAny(['lostLatCell','lostLonCell']) && post.get('lostAreaEdited',false))
          || (validLostCell(post,'lostLatCell','lostLonCell') && !post.get('lostAreaEdited',false)))
          && (!existsAfter(alert) || getAfter(alert).data.status != 'active' || alertMatchesPost(getAfter(alert).data, post));
      }
      allow update: if verified() && resource.data.authorId == request.auth.uid && resource.data.category == 'LOST'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text','imageUrl','videoUrl','searchTokens','lostMediaAssetId','lostAreaEdited','lostLatCell','lostLonCell'])
        && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 2000
        && request.resource.data.get('lostAreaEdited',false) is bool
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['lostLatCell','lostLonCell','lostAreaEdited']) || validAreaChange())
        && request.resource.data.searchTokens is list && request.resource.data.searchTokens.size() <= 2048
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['imageUrl','videoUrl','lostMediaAssetId']) || validLostMedia(request.resource.data));
      allow update: if signedIn()
        && (
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likedBy', 'likeCount'])
            && verified()
            && !blockedEitherWay(resource.data.authorId)
            && request.resource.data.likedBy is list
            && resource.data.likedBy is list
            && request.resource.data.likeCount == request.resource.data.likedBy.size()
            && (
              (request.resource.data.likedBy.size() == resource.data.likedBy.size() + 1
                && request.auth.uid in request.resource.data.likedBy
                && !(request.auth.uid in resource.data.likedBy)
                && request.resource.data.likedBy.hasAll(resource.data.likedBy))
              ||
              (request.resource.data.likedBy.size() + 1 == resource.data.likedBy.size()
                && request.auth.uid in resource.data.likedBy
                && !(request.auth.uid in request.resource.data.likedBy)
                && resource.data.likedBy.hasAll(request.resource.data.likedBy))
            ))
          ||
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['commentCount', 'lastCommentId'])
            && verified()
            && !blockedEitherWay(resource.data.authorId)
            && request.resource.data.commentCount == resource.data.get('commentCount', 0) + 1
            && request.resource.data.lastCommentId is string
            && !exists(/databases/$(database)/documents/posts/$(postId)/comments/$(request.resource.data.lastCommentId))
            && existsAfter(/databases/$(database)/documents/posts/$(postId)/comments/$(request.resource.data.lastCommentId))
            && getAfter(/databases/$(database)/documents/posts/$(postId)/comments/$(request.resource.data.lastCommentId)).data.authorId == request.auth.uid)
        );
      allow delete: if (signedIn() && resource.data.authorId == request.auth.uid) || admin();

      match /comments/{commentId} {
        function commentPath(id) {
          return /databases/$(database)/documents/posts/$(postId)/comments/$(id);
        }
        function validReply(d) {
          return d.keys().hasAll(['threadId','replyToId','replyToAuthorId','replyToName'])
            && d.threadId.matches('^[a-zA-Z0-9_-]{1,128}$') && d.replyToId.matches('^[a-zA-Z0-9_-]{1,128}$')
            && get(commentPath(d.replyToId)).data.authorId == d.replyToAuthorId
            && get(commentPath(d.replyToId)).data.get('authorName','Pawly') == d.replyToName
            && !blockedEitherWay(d.replyToAuthorId)
            && !('threadId' in get(commentPath(d.threadId)).data)
            && (d.replyToId == d.threadId || get(commentPath(d.replyToId)).data.threadId == d.threadId)
            && getAfter(commentPath(d.threadId)).data.lastReplyId == commentId;
        }
        allow read: if signedIn();
        allow create: if verified()
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 1000
          && !request.resource.data.keys().hasAny(['replyCount','lastReplyId'])
          && (!request.resource.data.keys().hasAny(['threadId','replyToId','replyToAuthorId','replyToName']) || validReply(request.resource.data))
          && !blockedEitherWay(get(/databases/$(database)/documents/posts/$(postId)).data.authorId);
        allow update: if verified()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['replyCount','lastReplyId'])
          && request.resource.data.replyCount == resource.data.get('replyCount',0) + 1
          && request.resource.data.lastReplyId.matches('^[a-zA-Z0-9_-]{1,128}$')
          && !exists(commentPath(request.resource.data.lastReplyId))
          && getAfter(commentPath(request.resource.data.lastReplyId)).data.threadId == commentId
          && getAfter(commentPath(request.resource.data.lastReplyId)).data.authorId == request.auth.uid;
        allow delete: if false;
      }
    }

    match /conversations/{conversationId} {
      allow create: if verified()
        && request.resource.data.keys().hasOnly(['participants', 'participantNames', 'participantPhotos', 'updatedAt'])
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && request.resource.data.participantNames is map
        && request.resource.data.participantNames.keys().hasAll(request.resource.data.participants)
        && request.resource.data.participantNames.keys().hasOnly(request.resource.data.participants)
        && request.resource.data.participantPhotos is map
        && request.resource.data.participantPhotos.keys().hasAll(request.resource.data.participants)
        && request.resource.data.participantPhotos.keys().hasOnly(request.resource.data.participants)
        && request.resource.data.participants[0] is string
        && request.resource.data.participants[1] is string
        && request.resource.data.participants[0] < request.resource.data.participants[1]
        && request.resource.data.participants[0] != request.resource.data.participants[1]
        && conversationId == request.resource.data.participants[0] + '_' + request.resource.data.participants[1]
        && request.auth.uid in request.resource.data.participants
        && exists(/databases/$(database)/documents/users/$(request.resource.data.participants[0]))
        && exists(/databases/$(database)/documents/users/$(request.resource.data.participants[1]))
        && request.resource.data.participantNames[request.resource.data.participants[0]] is string
        && request.resource.data.participantNames[request.resource.data.participants[0]].size() <= 60
        && request.resource.data.participantNames[request.resource.data.participants[0]] == get(/databases/$(database)/documents/users/$(request.resource.data.participants[0])).data.displayName
        && request.resource.data.participantNames[request.resource.data.participants[1]] is string
        && request.resource.data.participantNames[request.resource.data.participants[1]].size() <= 60
        && request.resource.data.participantNames[request.resource.data.participants[1]] == get(/databases/$(database)/documents/users/$(request.resource.data.participants[1])).data.displayName
        && request.resource.data.participantPhotos[request.resource.data.participants[0]] is string
        && request.resource.data.participantPhotos[request.resource.data.participants[0]] == get(/databases/$(database)/documents/users/$(request.resource.data.participants[0])).data.photoUrl
        && request.resource.data.participantPhotos[request.resource.data.participants[0]].size() <= 2048
        && (request.resource.data.participantPhotos[request.resource.data.participants[0]].size() == 0
          || request.resource.data.participantPhotos[request.resource.data.participants[0]].matches('^https://.+$'))
        && request.resource.data.participantPhotos[request.resource.data.participants[1]] is string
        && request.resource.data.participantPhotos[request.resource.data.participants[1]] == get(/databases/$(database)/documents/users/$(request.resource.data.participants[1])).data.photoUrl
        && request.resource.data.participantPhotos[request.resource.data.participants[1]].size() <= 2048
        && (request.resource.data.participantPhotos[request.resource.data.participants[1]].size() == 0
          || request.resource.data.participantPhotos[request.resource.data.participants[1]].matches('^https://.+$'))
        && !blockedEitherWay(request.resource.data.participants[0] == request.auth.uid ? request.resource.data.participants[1] : request.resource.data.participants[0]);
      // The client reads the deterministic conversation ID before creating it.
      // Permit checking a missing conversation only when the caller UID is encoded in its ID.
      allow get: if signedIn() && (
        resource == null
          ? conversationId.split('_').hasAny([request.auth.uid])
          : request.auth.uid in resource.data.participants
      );
      allow list: if signedIn() && request.auth.uid in resource.data.participants;
      allow update: if verified()
        && request.auth.uid in resource.data.participants
        && !blockedEitherWay(resource.data.participants[0] == request.auth.uid ? resource.data.participants[1] : resource.data.participants[0])
        && request.resource.data.participants == resource.data.participants
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessage', 'updatedAt'])
        && request.resource.data.lastMessage is string
        && request.resource.data.lastMessage.size() <= 120
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;

      match /messages/{messageId} {
        function canShareProfile(profileUid) {
          let members = get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
          let recipient = members[0] == request.auth.uid ? members[1] : members[0];
          return profileUid is string && profileUid.matches('^[A-Za-z0-9_-]{1,128}$')
            && get(/databases/$(database)/documents/users/$(profileUid)).data.isPublic == true
            && !blockedEitherWay(profileUid)
            && !exists(/databases/$(database)/documents/users/$(profileUid)/blocked/$(recipient))
            && !exists(/databases/$(database)/documents/users/$(recipient)/blocked/$(profileUid));
        }
        allow read: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants
          && !blockedEitherWay(get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants[0] == request.auth.uid ? get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants[1] : get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants[0]);
        allow create: if verified()
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.keys().hasOnly(['senderId', 'text', 'imageUrl', 'videoUrl', 'readBy', 'createdAt','sharedProfileUid'])
          && (!('sharedProfileUid' in request.resource.data) || canShareProfile(request.resource.data.sharedProfileUid))
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 2000
          && (request.resource.data.text.size() > 0
            || (request.resource.data.imageUrl is string && request.resource.data.imageUrl.size() > 0)
            || ('videoUrl' in request.resource.data && request.resource.data.videoUrl is string && request.resource.data.videoUrl.size() > 0))
          && request.resource.data.imageUrl is string
          && request.resource.data.imageUrl.size() <= 2048
          && (request.resource.data.imageUrl.size() == 0 || request.resource.data.imageUrl.matches('^https://.+$'))
          && (!('videoUrl' in request.resource.data)
            || (request.resource.data.videoUrl is string
              && (request.resource.data.videoUrl.size() == 0 || request.resource.data.videoUrl.matches('^https://.+$'))
              && request.resource.data.videoUrl.size() <= 2048))
          && request.resource.data.readBy is list
          && request.resource.data.readBy.size() == 1
          && request.auth.uid in request.resource.data.readBy
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants
          && !blockedEitherWay(get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants[0] == request.auth.uid ? get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants[1] : get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants[0]);
        allow update: if verified()
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants
          && !blockedEitherWay(get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants[0] == request.auth.uid ? get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants[1] : get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants[0])
          && resource.data.senderId != request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy'])
          && request.resource.data.readBy is list
          && request.auth.uid in request.resource.data.readBy
          && (
            (!('readBy' in resource.data) && request.resource.data.readBy.size() == 1)
            ||
            ('readBy' in resource.data && resource.data.readBy is list
              && request.resource.data.readBy.size() == resource.data.readBy.size() + 1
              && request.resource.data.readBy.hasAll(resource.data.readBy)
              && !(request.auth.uid in resource.data.readBy))
          );
        allow delete: if false;
      }
    }

    // Asset ownership index used by the trusted Worker for account deletion.
    match /cloudinaryAssets/{assetId} {
      // Only signed-in owners can index images inside their own Cloudinary upload folders.
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'publicId', 'resourceType', 'secureUrl', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.publicId is string
        && request.resource.data.publicId.size() <= 255
        && (!('secureUrl' in request.resource.data)
          || (request.resource.data.secureUrl is string
            && request.resource.data.secureUrl.size() <= 2048
            && request.resource.data.secureUrl.matches('^https://.*')))
        && request.resource.data.publicId.matches('^pawly/(profile-photos|dog-photos|pet-photos|post-photos|message-photos|diary-photos|post-videos|message-videos|diary-videos|pet-videos)/' + request.auth.uid + '/.+$')
        && request.resource.data.resourceType in ['image', 'video']
        && request.resource.data.createdAt == request.time;
      allow get, list: if signedIn() && resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    match /accountDeletionRequests/{requestId} {
      allow create: if signedIn()
        && requestId == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'email', 'requestedAt', 'status', 'source'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 254
        && request.resource.data.requestedAt == request.time
        && request.resource.data.status == 'pending'
        && request.resource.data.source in ['android', 'ios'];
      allow read: if (signedIn() && requestId == request.auth.uid) || admin();
      allow update, delete: if admin();
    }

    match /reports/{reportId} {
      allow create: if verified()
        && request.resource.data.keys().hasOnly(['reporterId', 'targetId', 'targetType', 'reason', 'status', 'createdAt'])
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.targetId is string
        && request.resource.data.targetId.size() > 0
        && request.resource.data.targetType in ['post', 'user', 'event', 'place']
        && request.resource.data.reason is string
        && request.resource.data.reason.size() > 0
        && request.resource.data.reason.size() <= 500
        && request.resource.data.status == 'open'
        && request.resource.data.createdAt == request.time
        && ((request.resource.data.targetType == 'post'
              && exists(/databases/$(database)/documents/posts/$(request.resource.data.targetId)))
          || (request.resource.data.targetType == 'user'
              && exists(/databases/$(database)/documents/users/$(request.resource.data.targetId)))
          || (request.resource.data.targetType == 'event'
              && exists(/databases/$(database)/documents/events/$(request.resource.data.targetId)))
          || (request.resource.data.targetType == 'place'
              && exists(/databases/$(database)/documents/communityPlaces/$(request.resource.data.targetId))));
      allow read, update, delete: if admin();
    }
    // Lost-pet alert subscriptions store deliberately coarse coordinates only.
    match /lostPetSubscriptions/{uid} {
      allow get: if owner(uid);
      allow list: if false;
      allow create, update: if owner(uid)
        && request.resource.data.keys().hasOnly(['uid', 'enabled', 'radiusKm', 'latCell', 'lonCell', 'updatedAt'])
        && request.resource.data.uid == uid
        && request.resource.data.enabled is bool
        && request.resource.data.radiusKm in [5, 10, 20, 30, 50, 100]
        && request.resource.data.latCell is int
        && request.resource.data.latCell >= -9000 && request.resource.data.latCell <= 9000
        && request.resource.data.lonCell is int
        && request.resource.data.lonCell >= -18000 && request.resource.data.lonCell <= 18000
        && request.resource.data.updatedAt == request.time;
      allow delete: if owner(uid);
    }

    // Alert coordinates are rounded by the app before storage; exact device locations are never saved.
    match /lostPetAlerts/{alertId} {
      function parentAfter() {
        return getAfter(/databases/$(database)/documents/posts/$(alertId)).data;
      }
      function ownsPost() {
        let post = get(/databases/$(database)/documents/posts/$(alertId)).data;
        return post.authorId == request.auth.uid && post.category == 'LOST';
      }
      allow get: if verified() && ((resource != null && resource.data.status == 'active') || ownsPost());
      allow list: if verified() && resource.data.status == 'active';
      allow create: if verified()
        && request.resource.data.keys().hasOnly(['postId', 'authorUid', 'dogName', 'latCell', 'lonCell', 'status', 'createdAt'])
        && request.resource.data.postId == alertId
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.dogName is string && request.resource.data.dogName.size() <= 40
        && validLostCell(request.resource.data,'latCell','lonCell')
        && !parentAfter().get('lostAreaEdited',false)
        && (!('lostLatCell' in parentAfter()) || alertMatchesPost(request.resource.data,parentAfter()))
        && request.resource.data.status == 'active'
        && request.resource.data.createdAt == request.time
        && exists(/databases/$(database)/documents/posts/$(alertId))
        && get(/databases/$(database)/documents/posts/$(alertId)).data.authorId == request.auth.uid
        && get(/databases/$(database)/documents/posts/$(alertId)).data.category == 'LOST';
      allow update: if verified() && resource.data.authorUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && (request.resource.data.status == 'resolved'
          || (request.resource.data.status == 'active' && validLostCell(request.resource.data,'latCell','lonCell')
            && !parentAfter().get('lostAreaEdited',false)
            && (!('lostLatCell' in parentAfter()) || alertMatchesPost(request.resource.data,parentAfter()))));
      allow update: if verified() && resource.data.authorUid == request.auth.uid && resource.data.status == 'active'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['latCell','lonCell','status'])
        && parentAfter().authorId == request.auth.uid && parentAfter().category == 'LOST'
        && ((request.resource.data.status == 'active' && alertMatchesPost(request.resource.data,parentAfter()))
          || (request.resource.data.status == 'paused' && !request.resource.data.keys().hasAny(['latCell','lonCell'])
            && parentAfter().get('lostAreaEdited',false) && !parentAfter().keys().hasAny(['lostLatCell','lostLonCell'])));
      allow delete: if false;
    }

    // Community places remain pending until an administrator reviews them.
    match /communityPlaces/{placeId} {
      // Any signed-in member can browse approved places; publishing still requires verified email.
      allow get, list: if admin() || (signedIn()
        && (resource.data.status == 'approved' || resource.data.authorUid == request.auth.uid));
      // Place creation is routed through the trusted Worker, which applies an atomic daily limit.
      allow create: if false;
      allow update: if admin() || (verified()
        && resource.data.authorUid == request.auth.uid
        && resource.data.status in ['pending', 'approved']
        && (request.resource.data.status == resource.data.status
          || (resource.data.status == 'approved' && request.resource.data.status == 'pending'))
        && request.resource.data.authorUid == resource.data.authorUid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'category', 'location', 'latitude', 'longitude', 'description', 'status'])
        && request.resource.data.name is string && request.resource.data.name.size() >= 3 && request.resource.data.name.size() <= 80
        && request.resource.data.category in ['Parque', 'Playa', 'Restaurante', 'Alojamiento', 'Ruta', 'Veterinario', 'Otro']
        && request.resource.data.location is string && request.resource.data.location.size() >= 3 && request.resource.data.location.size() <= 120
        && request.resource.data.latitude is number && request.resource.data.latitude >= -90 && request.resource.data.latitude <= 90
        && request.resource.data.longitude is number && request.resource.data.longitude >= -180 && request.resource.data.longitude <= 180
        && request.resource.data.description is string && request.resource.data.description.size() >= 10 && request.resource.data.description.size() <= 500);
      allow delete: if admin() || (verified() && resource.data.authorUid == request.auth.uid);
      /* old create validation replaced below
        && request.resource.data.keys().hasOnly(['name', 'category', 'location', 'latitude', 'longitude', 'description', 'authorUid', 'status', 'createdAt'])
        && request.resource.data.name is string && request.resource.data.name.size() >= 3 && request.resource.data.name.size() <= 80
        && request.resource.data.category in ['Parque', 'Playa', 'Restaurante', 'Alojamiento', 'Ruta', 'Veterinario', 'Otro']
        && request.resource.data.location is string && request.resource.data.location.size() >= 3 && request.resource.data.location.size() <= 120
        && request.resource.data.latitude is number && request.resource.data.latitude >= -90 && request.resource.data.latitude <= 90
        && request.resource.data.longitude is number && request.resource.data.longitude >= -180 && request.resource.data.longitude <= 180
        && request.resource.data.description is string && request.resource.data.description.size() >= 10 && request.resource.data.description.size() <= 500
      */
      // Administrators alone can change moderation status.
      allow update: if admin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status in ['approved', 'rejected'];
    }

    match /communityPlaceSubmissionLimits/{limitId} {
      allow read, write: if false;
    }

    // Phone-number hashes and daily discovery quotas are server-only records.
    match /phoneDirectory/{phoneHash} {
      allow read, write: if false;
    }
    match /phoneDiscoveryLimits/{limitId} {
      allow read, write: if false;
    }
    match /phoneVerificationTokens/{tokenId} {
      allow read, write: if false;
    }

    // Public events are tied to their venue, not to the private location of a person.
    match /events/{eventId} {
      function validMedia(data, urlKey, idKey, kind, folder) {
        return !data.keys().hasAny([urlKey, idKey]) || (
          data.keys().hasAll([urlKey, idKey]) && data[idKey] is string && data[idKey].matches('^[a-f0-9]{64}$')
          && data[urlKey] is string && data[urlKey].size() <= 2048
          && data[urlKey].matches('^https://res[.]cloudinary[.]com/[^/]+/' + kind + '/upload/.+')
          && ownedPostAsset(data[idKey], data[urlKey], kind, folder)
        );
      }
      function validEventContent(data) {
        return data.title is string && data.title.size() >= 4 && data.title.size() <= 90
        && data.description is string && data.description.size() >= 10 && data.description.size() <= 1200
        && data.category in ['Quedada', 'Ruta', 'Taller', 'Adopción']
        && data.location is string && data.location.size() >= 3 && data.location.size() <= 160
        && data.dateText is string && data.dateText.size() >= 4 && data.dateText.size() <= 80
        && data.startAt is timestamp && data.startAt > request.time
        && data.timeZoneId is string && data.timeZoneId.size() <= 64
        && ((!('latitude' in data) && !('longitude' in data))
          || ('latitude' in data && 'longitude' in data
            && data.latitude is number
            && data.latitude >= -90 && data.latitude <= 90
            && data.longitude is number
            && data.longitude >= -180 && data.longitude <= 180));
      }
      allow get, list: if signedIn();
      allow create: if verified()
        && request.resource.data.keys().hasOnly(['title', 'description', 'category', 'location', 'dateText', 'startAt', 'timeZoneId', 'latitude', 'longitude', 'organizerUid', 'organizerName', 'interestedCount', 'createdAt', 'photoUrl', 'photoAssetId', 'videoUrl', 'videoAssetId'])
        && validMedia(request.resource.data, 'photoUrl','photoAssetId','image','post-photos')
        && validMedia(request.resource.data, 'videoUrl','videoAssetId','video','post-videos')
        && validEventContent(request.resource.data)
        && request.resource.data.organizerUid == request.auth.uid
        && request.resource.data.organizerName is string && request.resource.data.organizerName.size() <= 60
        && request.resource.data.interestedCount == 0
        && request.resource.data.createdAt == request.time;
      allow update: if verified() && resource.data.organizerUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title','description','location','category','dateText','startAt','timeZoneId','latitude','longitude','photoUrl','photoAssetId','videoUrl','videoAssetId'])
        && validEventContent(request.resource.data)
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['photoUrl','photoAssetId']) || validMedia(request.resource.data,'photoUrl','photoAssetId','image','post-photos'))
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['videoUrl','videoAssetId']) || validMedia(request.resource.data,'videoUrl','videoAssetId','video','post-videos'));
      allow update: if verified()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['interestedCount'])
        && request.resource.data.interestedCount is int
        && (
          (request.resource.data.interestedCount == resource.data.interestedCount + 1
            && !exists(/databases/$(database)/documents/events/$(eventId)/interested/$(request.auth.uid))
            && existsAfter(/databases/$(database)/documents/events/$(eventId)/interested/$(request.auth.uid)))
          ||
          (request.resource.data.interestedCount == resource.data.interestedCount - 1
            && request.resource.data.interestedCount >= 0
            && exists(/databases/$(database)/documents/events/$(eventId)/interested/$(request.auth.uid))
            && !existsAfter(/databases/$(database)/documents/events/$(eventId)/interested/$(request.auth.uid)))
        );
      allow delete: if admin() || (verified() && resource.data.organizerUid == request.auth.uid);

      match /interested/{uid} {
        // Only the event organizer can list participants. Individual members can
        // still read their own RSVP, but cannot enumerate anyone else's attendance.
        // Attendee enumeration goes through the Worker, which also filters both block directions.
        allow list: if false;
        allow get: if signedIn() && request.auth.uid == uid;
        allow create: if verified() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['uid', 'createdAt'])
          && request.resource.data.uid == uid
          && request.resource.data.createdAt == request.time;
        allow delete: if verified() && request.auth.uid == uid;
        allow update: if false;
      }
    }

  }
}
