rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function verified() { return signedIn() && request.auth.token.email_verified == true; }
    function owner(uid) { return signedIn() && request.auth.uid == uid; }
    function blockedEitherWay(uid) {
      return signedIn() && (
        exists(/databases/$(database)/documents/users/$(uid)/blocked/$(request.auth.uid)) ||
        exists(/databases/$(database)/documents/users/$(request.auth.uid)/blocked/$(uid))
      );
    }
    function admin() { return signedIn() && request.auth.token.admin == true; }

    match /usernames/{username} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid;
      allow update: if false;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    match /users/{uid} {
      allow get: if owner(uid) || (signedIn() && resource.data.isPublic == true && !blockedEitherWay(uid));
      allow list: if signedIn() && resource.data.isPublic == true;
      allow create: if owner(uid)
        && request.resource.data.uid == uid
        && request.resource.data.username is string
        && request.resource.data.usernameLower is string
        && get(/databases/$(database)/documents/usernames/$(request.resource.data.usernameLower)).data.uid == uid;
      allow update: if (owner(uid)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.username == resource.data.username
        && request.resource.data.usernameLower == resource.data.usernameLower
        && (!('moderationStatus' in resource.data) || resource.data.moderationStatus != 'restricted' || request.resource.data.isPublic == false)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'bio', 'photoUrl', 'isPublic', 'dogProfiles']))
        || admin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isPublic', 'moderationStatus'])
        || verified()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['followersCount'])
        && (
          (request.resource.data.followersCount == resource.data.followersCount + 1
            && existsAfter(/databases/$(database)/documents/users/$(uid)/followers/$(request.auth.uid)))
          ||
          (request.resource.data.followersCount == resource.data.followersCount - 1
            && !existsAfter(/databases/$(database)/documents/users/$(uid)/followers/$(request.auth.uid)))
        )
        || verified()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['followingCount'])
        && (
          (request.resource.data.followingCount == resource.data.followingCount + 1
            && existsAfter(/databases/$(database)/documents/users/$(uid)/following/$(request.auth.uid)))
          ||
          (request.resource.data.followingCount == resource.data.followingCount - 1
            && !existsAfter(/databases/$(database)/documents/users/$(uid)/following/$(request.auth.uid)))
        );
      allow delete: if owner(uid);

      match /following/{otherUid} {
        allow read: if owner(uid) || (signedIn() && request.auth.uid == otherUid);
        allow create: if owner(uid) && verified() && request.resource.data.uid == otherUid && !blockedEitherWay(otherUid);
        allow delete: if owner(uid) || (signedIn() && request.auth.uid == otherUid);
        allow update: if false;
      }
      match /followers/{followerUid} {
        allow read: if owner(uid);
        allow create: if verified() && request.auth.uid == followerUid && request.resource.data.uid == followerUid && !blockedEitherWay(uid);
        allow delete: if owner(uid) || (signedIn() && request.auth.uid == followerUid);
        allow update: if false;
      }
      match /blocked/{otherUid} {
        allow read: if owner(uid) || (signedIn() && request.auth.uid == otherUid);
        allow create: if owner(uid) && request.resource.data.uid == otherUid;
        allow delete: if owner(uid);
        allow update: if false;
      }
    }

    match /posts/{postId} {
      allow read: if signedIn();
      allow create: if verified()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 2000
        && request.resource.data.imageUrl is string;
      allow update: if signedIn()
        && (
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likedBy', 'likeCount'])
            && verified()
            && !blockedEitherWay(resource.data.authorId)
            && request.resource.data.likedBy is list
            && request.resource.data.likeCount == request.resource.data.likedBy.size())
          ||
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['commentCount', 'lastCommentId'])
            && verified()
            && !blockedEitherWay(resource.data.authorId)
            && request.resource.data.commentCount == resource.data.commentCount + 1
            && request.resource.data.lastCommentId is string
            && existsAfter(/databases/$(database)/documents/posts/$(postId)/comments/$(request.resource.data.lastCommentId))
            && getAfter(/databases/$(database)/documents/posts/$(postId)/comments/$(request.resource.data.lastCommentId)).data.authorId == request.auth.uid)
        );
      allow delete: if (signedIn() && resource.data.authorId == request.auth.uid) || admin();

      match /comments/{commentId} {
        allow read: if signedIn();
        allow create: if verified()
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 1000
          && !blockedEitherWay(get(/databases/$(database)/documents/posts/$(postId)).data.authorId);
        allow update, delete: if false;
      }
    }

    match /conversations/{conversationId} {
      allow create: if verified()
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && request.auth.uid in request.resource.data.participants
        && !blockedEitherWay(request.resource.data.participants[0] == request.auth.uid ? request.resource.data.participants[1] : request.resource.data.participants[0]);
      allow read: if signedIn() && request.auth.uid in resource.data.participants;
      allow update: if verified()
        && request.auth.uid in resource.data.participants
        && !blockedEitherWay(resource.data.participants[0] == request.auth.uid ? resource.data.participants[1] : resource.data.participants[0])
        && request.resource.data.participants == resource.data.participants
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessage', 'updatedAt']);
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants
          && !blockedEitherWay(get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants[0] == request.auth.uid ? get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants[1] : get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants[0]);
        allow create: if verified()
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants
          && !blockedEitherWay(get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants[0] == request.auth.uid ? get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants[1] : get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants[0]);
        allow update, delete: if false;
      }
    }

    match /reports/{reportId} {
      allow create: if verified()
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.targetId is string
        && request.resource.data.reason is string;
      allow read, update, delete: if admin();
    }
  }
}